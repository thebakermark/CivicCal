# Copy to /etc/civiccal/civiccal.env and adjust only after provisioning.
# The API service is intentionally loopback-only.
CIVICCAL_STATE_FILE=/srv/civiccal/data/state/identity.json
CIVICCAL_MANIFEST_FILE=/srv/civiccal/data/publication/source.json
CIVICCAL_REGISTRY_FILE=/srv/civiccal/data/registry/sources.json
CIVICCAL_PORT=8765
